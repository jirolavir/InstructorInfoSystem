@model InstructorInfoSystem.ViewModels.DeleteAccountViewModel

@{
    ViewData["Title"] = "Delete Account";
}

<div class="profile-page">
    <div class="profile-card">
        <div class="delete-account-header">
            <h2>Delete Account</h2>
            <p>This action cannot be undone.</p>
        </div>

        <div class="profile-content">
            <div class="delete-account-warning">
                <strong>Important</strong>
                <p>
                    Deleting your account permanently removes your account information.
                    To continue, enter your current password and type
                    <strong>DELETE</strong> in the confirmation field.
                </p>
            </div>

            <form asp-action="DeleteAccount" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword"
                           type="password"
                           class="form-control"
                           autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ConfirmationText" class="form-label">
                        Type DELETE to confirm
                    </label>
                    <input asp-for="ConfirmationText" class="form-control" />
                    <span asp-validation-for="ConfirmationText" class="text-danger"></span>
                </div>

                <div class="profile-actions">
                    <button type="submit" class="profile-delete-button">
                        Delete My Account
                    </button>
                    <a asp-action="Profile" class="profile-cancel-button">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}