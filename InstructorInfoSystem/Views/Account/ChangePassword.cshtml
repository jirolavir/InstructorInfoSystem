@model InstructorInfoSystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="profile-page">
    <div class="profile-card">
        <div class="profile-header">
            <div>
                <h2>Change Password</h2>
                <p>Enter your current password and choose a new one.</p>
            </div>
        </div>

        <div class="profile-content">
            <div class="profile-security mb-4">
                <strong>Keep your account secure</strong>
                <p>Use a password you don't use on other accounts.</p>
            </div>

            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ConfirmNewPassword" class="form-label"></label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                </div>

                <div class="profile-actions">
                    <button type="submit" class="dashboard-button">Change Password</button>
                    <a asp-action="Profile" class="profile-cancel-button">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}